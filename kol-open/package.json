{
  "name": "kol-open",
  "version": "1.0.0",
  "private": true,
  "description": "隔壁老王 KOL 合作勞務回傳系統（Cloudflare Pages + Functions + D1 + R2）",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name=kol-open",
    "db:init": "wrangler d1 execute kol-open-db --remote --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create kol-open-files",
    "d1:create": "wrangler d1 create kol-open-db"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
